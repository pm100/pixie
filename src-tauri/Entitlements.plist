<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- libheif and libde265 ship inside the app as separate dylibs (LGPL). Without this, the hardened runtime refuses
       them unless the same Team ID signed them, which an unsigned (ad-hoc) build cannot satisfy. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Emailing a photo controls the mail app with AppleScript (see Info.plist). -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
