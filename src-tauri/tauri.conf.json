{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pixie",
  "version": "0.1.0",
  "identifier": "app.pixie.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Pixie", "width": 1200, "height": 800, "minWidth": 700, "minHeight": 500 }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: pixie: http://pixie.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Pixie",
    "shortDescription": "A simple photo and video manager",
    "longDescription": "Browse your photos and videos, find them by Auto tag and by the people in them. Everything stays on your computer.",
    "licenseFile": "../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false, "installerHooks": "installer-hooks.nsh" }
    }
  }
}
